{
  "name": "auditnote",
  "private": true,
  "version": "0.3.0",
  "description": "AuditNote — 轻量的本地 Markdown 阅读与编辑工具",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:msi": "tauri build --bundles msi",
    "build:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "perf:doc": "node scripts/make-large-doc.mjs",
    "icons": "tauri icon assets/icon.png",
    "shell:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-shell.ps1",
    "shell:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-shell.ps1 -Unregister"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
