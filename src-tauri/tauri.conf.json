{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuditNote",
  "version": "0.3.0",
  "identifier": "com.auditnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuditNote",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AuditNote",
    "copyright": "© 2026 AuditNote",
    "category": "Productivity",
    "shortDescription": "轻量的本地 Markdown 阅读与编辑工具",
    "longDescription": "AuditNote 是一个完全离线运行的 Markdown 阅读与编辑器：打开本地文件即可渲染预览、纯文本编辑与保存，支持 GFM、代码高亮、公式与 Mermaid，可导出 HTML 与 PDF。",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
